#    topics: ["/sonar1", "/sonar3", "/sonar4"]
#    no_readings_timeout: 1.0
#    clear_threshold: 0.2
#    mark_threshold: 0.9 #0.8
#    clear_on_max_reading: false #true #21.01.11 sykim

inflation:
    inflation_radius: 0.43 #.36 #0.35
