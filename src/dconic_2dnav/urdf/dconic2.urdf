<?xml version="1.0"?>
<robot name="dconic2">
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
  </material>

  <material name="green">
    <color rgba="1 0 0 1"/>
  </material>

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="darkgray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <link name="base_link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.527"/>
      <geometry>
        <box size="0.68 0.68 1.0"/>
      </geometry>
      <material name="darkgray"/>
    </visual>
  </link>


  <link name="base_imu_link2">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_link_to_imu2" type="fixed">
    <parent link="base_link2"/>
    <child link="base_imu_link2"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>  

  <link name="base_scan_link2">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_link_to_scan2" type="fixed">
    <parent link="base_link2"/>
    <child link="base_scan_link2"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>  

</robot>
