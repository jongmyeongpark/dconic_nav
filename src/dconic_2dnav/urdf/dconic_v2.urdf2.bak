<?xml version="1.0"?>
<robot name="dconic">
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
  </material>

  <material name="green">
    <color rgba="1 0 0 1"/>
  </material>

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="darkgray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.527"/>
      <geometry>
        <box size="0.52 0.52 1.0"/>
      </geometry>
      <material name="darkgray"/>
    </visual>
  </link>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.57075 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin rpy="0 0 0" xyz="0 0.192 0.1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.57075 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin rpy="0 0 0" xyz="0 -0.192 0.1"/>
  </joint>

  <link name="front_laser">
    <visual>
      <geometry>
        <box size="0.075 0.065 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="base_to_front_laser" type="fixed">
    <parent link="base_link"/>
    <child link="front_laser"/>
    <origin rpy="0 0 0" xyz="0.211 0.0 0.127"/>
  </joint>

  <link name="rear_laser">
    <visual>
      <geometry>
        <box size="0.075 0.065 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="base_to_rear_laser" type="fixed">
    <parent link="base_link"/>
    <child link="rear_laser"/>
    <origin rpy="0 0 -3.14" xyz="-0.211 0.0 0.127"/>
  </joint>

  <link name="usb_cam">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="green"/>
    </visual>
  </link>

  <joint name="base_to_usb_cam" type="fixed">
    <parent link="base_link"/>
    <child link="usb_cam"/>
    <origin rpy="0 0 0" xyz="0.30 -0.09 0.127"/>
  </joint>

  
  <link name="sonar_bottom_fl">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_to_sonar_bottom_fl" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_bottom_fl"/>
    <origin rpy="0 0 0" xyz="0.37 0.103 0.20"/>
  </joint>

  <link name="sonar_bottom_fr">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_to_sonar_bottom_fr" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_bottom_fr"/>
    <origin rpy="0 0 0" xyz="0.37 -0.103 0.20"/>
  </joint>

  <link name="sonar_bottom_rl">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_to_sonar_bottom_rl" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_bottom_rl"/>
    <origin rpy="0 0 3.141592" xyz="-0.37 0.103 0.20"/>
  </joint>

  <link name="sonar_bottom_rr">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_to_sonar_bottom_rr" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_bottom_rr"/>
    <origin rpy="0 0 3.141592" xyz="-0.37 -0.103 0.20"/>
  </joint>

  <link name="sonar_bottom_left">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_to_sonar_bottom_left" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_bottom_left"/>
    <origin rpy="0 0 1.570796" xyz="0.103 0.37 0.20"/>
  </joint>

  <link name="sonar_bottom_right">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_to_sonar_bottom_right" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_bottom_right"/>
    <origin rpy="0 0 -1.570796" xyz="0.103 -0.37 0.20"/>
  </joint>

  <link name="base_footprint">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_link_to_base_footprint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>  

  <link name="base_imu_link">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="base_imu_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>  

  <link name="base_scan_link">
    <visual>
      <geometry>
        <box size="0.015 0.045 0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="base_link_to_scan" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>  

  

</robot>
