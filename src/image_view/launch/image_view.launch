<launch>
    <env name='DISPLAY' value=":0.0" />
    <node name="image_view" pkg="image_view" type="image_view" output="screen" >
    <!-- <node name="image_view" pkg="image_view" type="image_view" output="screen" respawn="true" respawn_delay="5"> -->
        <remap from="image" to="/result_fullscreen_detection_image" />
        <param name="image_transport" value="compressed" />
    </node>
</launch>