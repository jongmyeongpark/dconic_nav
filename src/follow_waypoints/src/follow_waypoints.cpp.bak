void pathRunRequestCallback(const std_msgs::String & msg){

    //ROS_INFO("path_file_name = %s", path_file_name.c_str());
    std::string repetCountString = msg.data.substr(0, 4); //repetitions and time
    //sub_time = path_file_name.substr(2, 4); //time
    std::string pathName = msg.data.substr(4); //file name

    int repeatCount = 0 ;
    if ( std::stoi(repetCountString.substr(0, 1)) == 0 ){
        repeatCount = std::stoi( msg.data.substr(1,1) ) ;
    }
    else {
        repeatCount = std::stoi( msg.data.substr(0,2) ) ;
    }
        
    if (!repeatCount > 0){
        ROS_ERROR("repeat count must be > 0");
        return; 
    }

    std::cout << "repeat Count : " << repeatCount << std::endl;

    goalRouteRepetition_ = repeatCount;

    std::string file_name = "/home/nvidia/dconic_nav/src/follow_waypoints/saved_path/" + pathName;
    std::ifstream fin;
    fin.open(file_name.c_str());
    std::string line = "";

    if(!fin.is_open()){
        ROS_ERROR("waypoint file cannot open.\n");
    }
    else {
        waypointPoseArray_.poses.clear();
        waypointPoseArray_.header.frame_id="map";
        waypointPoseArray_.header.stamp = ros::Time::now();
    }
    

    int str_len = 0;

    char split = ',';
    std::string pose_data = "";
    float temp = 0.0;
    int cnt = 0;
    while(std::getline(fin, line)){
        str_len = strlen(line.c_str());
        if(str_len > 0){
            geometry_msgs::Pose pose;
            std::istringstream ss2(line);
            //ROS_INFO("[wp_pub] %s", line.c_str());

            std::getline(ss2, pose_data, split);
            std::stringstream stof1(pose_data);
            stof1 >> temp;
            pose.position.x = temp;

            std::getline(ss2, pose_data, split);
            std::stringstream stof2(pose_data);
            stof2 >> temp;
            pose.position.y = temp;

            std::getline(ss2, pose_data, split);
            std::stringstream stof3(pose_data);
            stof3 >> temp;
            pose.position.z = temp;
            
            std::getline(ss2, pose_data, split);
            std::stringstream stof4(pose_data);
            stof4 >> temp;
            pose.orientation.x = temp;
            
            std::getline(ss2, pose_data, split);
            std::stringstream stof5(pose_data);
            stof5 >> temp;
            pose.orientation.y = temp;
            
            std::getline(ss2, pose_data, split);
            std::stringstream stof6(pose_data);
            stof6 >> temp;
            pose.orientation.z = temp;
            
            std::getline(ss2, pose_data, split);
            std::stringstream stof7(pose_data);
            stof7 >> temp;
            pose.orientation.w = temp;

            waypointPoseArray_.poses.push_back(pose);            
        }
    }

    waypointCount_ = waypointPoseArray_.poses.size();
    if (waypointCount_ <= 0){
        return;
    }
    lastWaypointGoalPose_ = waypointPoseArray_.poses[waypointPoseArray_.poses.size()-1];
    lastWaypointGoalPosePublisher_.publish(lastWaypointGoalPose_);
    lastWaypointIndex_ = waypointPoseArray_.poses.size()-1;
    std_msgs::Int32 lastWaypointIndexMsg;
    lastWaypointIndexMsg.data = lastWaypointIndex_;
    lastWaypointIndexPublisher_.publish(lastWaypointIndexMsg);

    std_msgs::Int32 goalRouteRepetitionMsg;
    goalRouteRepetitionMsg.data = goalRouteRepetition_;
    goalRouteRepetitionPublisher_.publish(goalRouteRepetitionMsg);


    geometry_msgs::PoseArray tempPoseArray = waypointPoseArray_;

    for (int i = 0 ; i < repeatCount -1 ; ++i) {
        for (int j = 0 ; j < tempPoseArray.poses.size() ; ++ j){
           waypointPoseArray_.poses.push_back(tempPoseArray.poses[j]);
        }
    }

    std::cout << "poses size : " << waypointPoseArray_.poses.size() << std::endl;

    move_base_msgs::MoveBaseGoal goal;
    //we'll send a goal to the robot to move 1 meter forward
    goal.target_pose.header.frame_id = "map";
    goal.target_pose.header.stamp = ros::Time::now();
    goal.target_pose.pose = waypointPoseArray_.poses[0];
    ROS_INFO("Sending goal");
    ac_->sendGoal(goal);

    // move_base_msgs::MoveBaseActionGoal goalMsg;
    // goalMsg.header.frame_id="map";
    // goalMsg.header.stamp = goal.target_pose.header.stamp;
    // goalMsg.goal_id.stamp = goalMsg.header.stamp ;
    // // goalMsg.goal.target_pose.header.frame_id = "map";
    // // goalMsg.goal.target_pose.header.stamp = goalMsg.header.stamp;
    // // goalMsg.goal.target_pose.pose = waypointPoseArray_.poses[0];
    // goalMsg.goal = goal;
    // moveBaseGoalPub_.publish(goalMsg);
    // std_srvs::Empty::Request req;
    // std_srvs::Empty::Response resp;
    // ros::service::call("move_base/clear_costmaps", req, resp);

    currentDrivingWaypoint_ = 0 ;

    drivingState_ = 2;

    currentRouteRepetition_ = 1;
}

void moveBaseGoalCallback(const move_base_msgs::MoveBaseActionGoal & goalMsg){
    // waypointPoseArray_.poses.clear();
    // waypointPoseArray_.poses.push_back(goalMsg.goal.target_pose.pose);
    // currentDrivingWaypoint_ = 0;
    // drivingState_ = 2;
    std_srvs::Empty::Request req;
    std_srvs::Empty::Response resp;
    ros::service::call("move_base/clear_costmaps", req, resp);

    currentTargetGoalPose_ = goalMsg.goal.target_pose.pose;
    drivingState_ = 2;
}

