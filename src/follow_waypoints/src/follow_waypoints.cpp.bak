void pathRunCancelRequestCallback(const std_msgs::Empty & msg){
    currentDrivingWaypoint_ = -1;
    waypointPoseArray_.poses.clear();   
    drivingState_ = 0;
    waypointCount_ = 0;
    currentRouteRepetition_ = 0;
    goalRouteRepetition_ = 0;
    currentTargetGoalPose_.position.x = 0 ; 
    currentTargetGoalPose_.position.y = 0 ;
}

void moveRequestCallback(const std_msgs::Int32 & msg){

    if (msg.data == 1)
    {
        if (drivingState_ == 2){
            if ( (waypointPoseArray_.poses.size() > 0 && currentDrivingWaypoint_ > -1 && waypointPoseArray_.poses.size() > currentDrivingWaypoint_) ||  (currentTargetGoalPose_.position.x !=0 || currentTargetGoalPose_.position.y !=0) ){

                actionlib_msgs::GoalID actionlibGoalIdMsg;
                //actionlibGoalIdMsg.id = std::string("follow_waypoints_pause_") + std::to_string(ros::Time::now().toSec());
                moveBaseCancelPub_.publish(actionlibGoalIdMsg);
                drivingState_ = 1;
            }
        }
    }
    else if (msg.data == 2){
        if (drivingState_ == 1){
            if ( waypointPoseArray_.poses.size() > 0 && currentDrivingWaypoint_ > -1 && waypointPoseArray_.poses.size() > currentDrivingWaypoint_ ){
                                
                std_srvs::Empty::Request req;
                std_srvs::Empty::Response resp;
                ros::service::call("move_base/clear_costmaps", req, resp);

                move_base_msgs::MoveBaseGoal goal;
                //we'll send a goal to the robot to move 1 meter forward
                goal.target_pose.header.frame_id = "map";
                goal.target_pose.header.stamp = ros::Time::now();
                goal.target_pose.pose = waypointPoseArray_.poses[currentDrivingWaypoint_];
                ROS_INFO("Sending goal");
                ac_->sendGoal(goal);

                // move_base_msgs::MoveBaseActionGoal goalMsg;
                // goalMsg.header.frame_id="map";
                // goalMsg.header.stamp = goal.target_pose.header.stamp;
                // goalMsg.goal_id.stamp = goalMsg.header.stamp ;
                // // goalMsg.goal.target_pose.header.frame_id = "map";
                // // goalMsg.goal.target_pose.header.stamp = goalMsg.header.stamp;
                // // goalMsg.goal.target_pose.pose = waypointPoseArray_.poses[0];
                // goalMsg.goal = goal;
                // moveBaseGoalPub_.publish(goalMsg);
                drivingState_ = 2;
            }

            else if (currentTargetGoalPose_.position.x !=0 || currentTargetGoalPose_.position.y !=0){
                move_base_msgs::MoveBaseGoal goal;
                //we'll send a goal to the robot to move 1 meter forward
                goal.target_pose.header.frame_id = "map";
                goal.target_pose.header.stamp = ros::Time::now();
                goal.target_pose.pose = currentTargetGoalPose_;
                ROS_INFO("Sending goal");
                ac_->sendGoal(goal);

                // move_base_msgs::MoveBaseActionGoal goalMsg;
                // goalMsg.header.frame_id="map";
                // goalMsg.header.stamp = goal.target_pose.header.stamp;
                // goalMsg.goal_id.stamp = goalMsg.header.stamp ;
                // // goalMsg.goal.target_pose.header.frame_id = "map";
                // // goalMsg.goal.target_pose.header.stamp = goalMsg.header.stamp;
                // // goalMsg.goal.target_pose.pose = waypointPoseArray_.poses[0];
                // goalMsg.goal = goal;
                // moveBaseGoalPub_.publish(goalMsg);
                
                std_srvs::Empty::Request req;
                std_srvs::Empty::Response resp;
                ros::service::call("move_base/clear_costmaps", req, resp);

                drivingState_ = 2;
            }
        }
    }
}

void clearFollowWaypointsCallback(const std_msgs::Empty & msg){
    drivingState_ = 0;
    // waypointCount_ = 0;
    // currentRouteRepetition_ = 0;
    // goalRouteRepetition_ = 0;
    currentTargetGoalPose_.position.x = 0 ; 
    currentTargetGoalPose_.position.y = 0 ;
}

void startAutoParkingCallback(const std_msgs::Empty & msg){
    currentDrivingWaypoint_ = -1;
    waypointPoseArray_.poses.clear();   
    drivingState_ = 0;
    waypointCount_ = 0;
    currentRouteRepetition_ = 0;
    goalRouteRepetition_ = 0;
    currentTargetGoalPose_.position.x = 0 ; 
    currentTargetGoalPose_.position.y = 0 ;
}

int main (int argc, char** argv){
    ros::init(argc, argv, "follow_waypoints");
    ros::NodeHandle nh;

    ros::Subscriber amclPoseSub = nh.subscribe("/amcl_pose", 10, amclPoseCallback);
    ros::Subscriber moveBaseResultSub = nh.subscribe("/move_base/result", 10, moveBaseResultCallback);
    ros::Subscriber moveBaseStatusSub = nh.subscribe("/move_base/status", 10, moveBaseStatusCallback);
    ros::Subscriber pathRepetSub = nh.subscribe("/path_run_request", 10, pathRunRequestCallback);
    ros::Subscriber pathRunCancelRequestSub = nh.subscribe("/path_run_cancel_request", 10, pathRunCancelRequestCallback);
    ros::Subscriber moveRequestSub = nh.subscribe("/move_request", 10, moveRequestCallback);
    ros::Subscriber moveBaseCancelSub = nh.subscribe("/move_base/cancel", 10, moveBaseCancelCallback);

    ros::Subscriber moveBaseGoalSub = nh.subscribe("/move_base/goal", 10, moveBaseGoalCallback);
    ros::Subscriber clearFollowWaypointsSub = nh.subscribe("/clear_follow_waypoints", 10 , clearFollowWaypointsCallback);

    ros::Subscriber startAutoParkingSub = nh.subscribe("/start_auto_parking", 1, startAutoParkingCallback);

    moveBaseCancelPub_ = nh.advertise<actionlib_msgs::GoalID>("/move_base/cancel", 10);
    moveBaseGoalPub_ = nh.advertise<move_base_msgs::MoveBaseActionGoal>("/move_base/goal", 10);
    //ros::Publisher waypointsPub = nh.advertise<geometry_msgs::PoseArray>("/waypoints", 10);

    lastWaypointGoalPosePublisher_ = nh.advertise<geometry_msgs::Pose>("/last_waypoint_goal_pose", 10);
    lastWaypointIndexPublisher_ = nh.advertise<std_msgs::Int32>("/last_waypoint_index", 10);
    goalRouteRepetitionPublisher_ = nh.advertise<std_msgs::Int32>("/goal_route_repetition", 10);

    ros::Publisher currentWaypointFromFwPub = nh.advertise<std_msgs::Int32>("/current_waypoint_from_fw", 10);

    ros::Publisher drivingStatePub = nh.advertise<std_msgs::Int32>("/driving_state", 10);

    ros::Publisher currentRouteRepetitionPub = nh.advertise<std_msgs::Int32>("/current_route_repetition_from_fw", 10);

    ros::Publisher waypointFinishedPub = nh.advertise<std_msgs::Empty>("/waypoint_finished", 1);

    ros::Rate loop_rate(10);   
    
    distanceTolerance_ = 1.0;

    currentDrivingWaypoint_ = -1 ;

    drivingState_ = 0;

    waypointCount_ = 0;
    goalRouteRepetition_ = 0;
    currentRouteRepetition_ = 0;
    cumulativeAngle_ = 0.0;

    //ac_ = actionlib::SimpleActionClient<move_base_msgs::MoveBaseAction>("move_Base", true);
    ac_ = new actionlib::SimpleActionClient<move_base_msgs::MoveBaseAction>("move_base", true);

    while(!ac_->waitForServer(ros::Duration(5.0))){
       ROS_INFO("Waiting for the move_base action server to come up");
    }

    while(ros::ok()){

        if ( (currentDrivingWaypoint_ >= 0) && (currentDrivingWaypoint_ < (waypointPoseArray_.poses.size() -1)) ){
            
            std:: cout << "distance : " << getDistance(waypointPoseArray_.poses[currentDrivingWaypoint_], robotPose_.pose.pose) << std::endl;
            if ( getDistance(waypointPoseArray_.poses[currentDrivingWaypoint_], robotPose_.pose.pose) <= distanceTolerance_)
            {
                ++currentDrivingWaypoint_;

                move_base_msgs::MoveBaseGoal goal;
                //we'll send a goal to the robot to move 1 meter forward
                goal.target_pose.header.frame_id = "map";
                goal.target_pose.header.stamp = ros::Time::now();
                goal.target_pose.pose = waypointPoseArray_.poses[currentDrivingWaypoint_];
                ROS_INFO("Sending goal");
                ac_->sendGoal(goal);

                // move_base_msgs::MoveBaseActionGoal goalMsg;
                // goalMsg.header.frame_id="map";
                // goalMsg.header.stamp = goal.target_pose.header.stamp;
                // goalMsg.goal_id.stamp = goalMsg.header.stamp ;
                // // goalMsg.goal.target_pose.header.frame_id = "map";
                // // goalMsg.goal.target_pose.header.stamp = goalMsg.header.stamp;
                // // goalMsg.goal.target_pose.pose = waypointPoseArray_.poses[0];
                // goalMsg.goal = goal;
                // moveBaseGoalPub_.publish(goalMsg);

                std_srvs::Empty::Request req;
                std_srvs::Empty::Response resp;
                ros::service::call("move_base/clear_costmaps", req, resp);
            }
            currentRouteRepetition_ = currentDrivingWaypoint_ / waypointCount_ + 1;
        }
        else if ((currentDrivingWaypoint_ >= 0) && (currentDrivingWaypoint_ == (waypointPoseArray_.poses.size() -1))){
            if ( getDistance(waypointPoseArray_.poses[currentDrivingWaypoint_], robotPose_.pose.pose) <= 0.6 && getAngleDifference(waypointPoseArray_.poses[currentDrivingWaypoint_], robotPose_.pose.pose) <= 15 ){
                actionlib_msgs::GoalID actionlibGoalIdMsg;
                //actionlibGoalIdMsg.id = std::string("follow_waypoints_pause_") + std::to_string(ros::Time::now().toSec());
                moveBaseCancelPub_.publish(actionlibGoalIdMsg);
                currentDrivingWaypoint_ = -1;
                waypointPoseArray_.poses.clear();   
                drivingState_ = 0;
                waypointCount_ = 0;
                currentRouteRepetition_ = 0;
                goalRouteRepetition_ = 0;
                currentTargetGoalPose_.position.x = 0 ; 
                currentTargetGoalPose_.position.y = 0 ;
                
                std_msgs::Empty finishedEmptyMsg;
                waypointFinishedPub.publish(finishedEmptyMsg);
            }        
        }

        std::cout << "currentDrivingWaypoint_ : " << currentDrivingWaypoint_ % waypointCount_ << std::endl;
        //std::cout << "currentRouteRepetition_ : " << currentRouteRepetition_ << std::endl;
        std_msgs::Int32 currentDrivingWaypointData;
        currentDrivingWaypointData.data = currentDrivingWaypoint_ % waypointCount_;
        currentWaypointFromFwPub.publish(currentDrivingWaypointData);


        if (previousDrivingState_ != drivingState_){
            std_msgs::Int32 drivingStateMsg;
            drivingStateMsg.data = drivingState_;
            drivingStatePub.publish(drivingStateMsg);
            previousDrivingState_ = drivingState_;
        }

        std_msgs::Int32 currentRouteRepetitionMsg;
        currentRouteRepetitionMsg.data = currentRouteRepetition_;
        currentRouteRepetitionPub.publish(currentRouteRepetitionMsg);
        
        //std::cout << "cumulativeAngle : " << cumulativeAngle_ << std::endl;
        
        ros::spinOnce();
        loop_rate.sleep();
    }
}

