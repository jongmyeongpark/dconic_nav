#!/usr/bin/env python
import rospy
import cv2
import os
from sensor_msgs.msg import Image
from std_msgs.msg import Int32
from cv_bridge import CvBridge

bridge = CvBridge()

# ========================================
# 특정 waypoint만 찍을 때 사용
# 아래 CAPTURE_AT 리스트에 번호 입력
# ========================================
CAPTURE_AT = [2, 4, 6]

# 저장 경로
SAVE_DIR = "/home/nvidia/waypoint_images"
os.makedirs(SAVE_DIR, exist_ok=True)

prev_waypoint = -1

def waypoint_cb(msg):
    global prev_waypoint
    curr = msg.data

    if curr != prev_waypoint and prev_waypoint >= 0:
        arrived = prev_waypoint

        rospy.loginfo(f"Waypoint {arrived} 완료 감지")

        # ========================================
        # 모든 waypoint에서 촬영 (현재 활성화)
        # 특정 waypoint만 찍으려면 아래 주석 해제하고
        # 이 if문은 주석 처리
        # ========================================
        # if arrived >= 0:  # 항상 찍기
        if arrived in CAPTURE_AT:  # 특정 번호만 찍기
            rospy.loginfo(f"→ 촬영 시작! waypoint {arrived}")
            capture("/camera1/usb_cam1/image_raw", arrived, "cam1")
            capture("/camera2/usb_cam2/image_raw", arrived, "cam2")

    prev_waypoint = curr

def capture(topic, wp_idx, cam_name):
    try:
        msg = rospy.wait_for_message(topic, Image, timeout=3.0)
        img = bridge.imgmsg_to_cv2(msg, "bgr8")
        filename = f"{SAVE_DIR}/wp{wp_idx:03d}_{cam_name}.jpg"
        cv2.imwrite(filename, img)
        rospy.loginfo(f"저장 완료: {filename}")
    except rospy.ROSException:
        rospy.logwarn(f"{cam_name} timeout - 이미지 수신 실패")

if __name__ == "__main__":
    rospy.init_node("waypoint_camera_capture")
    rospy.Subscriber("/current_waypoint_from_fw", Int32, waypoint_cb)
    rospy.loginfo("waypoint_camera_capture 노드 시작")
    rospy.spin()