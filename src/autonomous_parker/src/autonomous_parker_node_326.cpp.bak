    // }
}

void exceptionalTerminationCallback(const std_msgs::Int32& msg){
    isBleTerminatedExceptionally_ = true;
    //isCharging_ = false;
}

void isChargingFromBleCallback(const std_msgs::Int32& msg){
    
    if (msg.data == 0){
        if (parkingState_ == FINISHED){
            parkingState_ = INITIALIZING;            
            parkingStateString_ = std::string("INITIALIZING");
            std::cout << "State : Initializing..";
                        
        }
        isDockConnected_ = false;
        //isCharging_ = false;
    }
    else if (msg.data == 1 || msg.data == 2){
        if (parkingState_ != MOVING_BACK_TO_JOURNEY && parkingState_ != FINISHED){
            geometry_msgs::Twist movingTwistMsg;
            movingTwistMsg.linear.x = 0.0; 
            movingTwistMsg.angular.z = 0.0;
            cmdVelPub_.publish(movingTwistMsg);
            
            isRequestedStartAutoParking_ = false;
            parkingState_ = FINISHED;            
            parkingStateString_ = std::string("FINISHED");
            std::cout << "State : Finished";

            std_msgs::String stringMsg;
            stringMsg.data = "charging_point";
            driveCompletedPublisher_.publish(stringMsg);

        }
        isDockConnected_ = true;
        //isCharging_ = true;
    }
}

void isChargingFromBatteryCallback(const std_msgs::Bool& msg){
    isCharging_ = msg.data;
    isDockConnected_ = msg.data;

    if(parkingState_ != ADJUSTING_FORWARD || parkingState_ != FINISHED){
        if (isCharging_){
            parkingState_ = FINISHED;
            parkingStateString_ = std::string("FINISHED");
        }
    }

    if (isChargingOld_ != isCharging_){
        if (isCharging_){
            std_msgs::Empty emptyMsg;
            justStartedChargingPublisher_.publish(emptyMsg);
        }
        else {
            std_msgs::Empty emptyMsg;
            justTakenOutChargingPublisher_.publish(emptyMsg);
        }
    }
    
    isChargingOld_ = isCharging_;


}

void initialDriveForTurnCallback(const std_msgs::Empty& msg){
    parkingState_ = TURN_AFTER_MOVING_BACK_TO_JOURNEY;
    parkingStateString_ = std::string("TURN_AFTER_MOVING_BACK_TO_JOURNEY");
}

void initialRunStartCallback(const std_msgs::Empty &msg){
    // std_msgs::String pathMsg;
    // pathMsg.data = "0400park_map_12_3_0517-2.csv";
    // pathRunRequestPublisher_.publish(pathMsg);
    runStartCount_ = 4;
    if (parkingState_ == FINISHED){
        isStartJourney_ = true;
        //pathRunRequestMsg_ = msg;
    }
    else if (parkingState_ == IDLE){
        targetBackMovingDistance_ = 0.8;
        parkingState_= MOVING_BACK_TO_JOURNEY;
        parkingStateString_ = std::string("MOVING_BACK_TO_JOURNEY"); 
        isCharging_ = false;
    }
}

void runStartCountCallback(const std_msgs::Int32 &msg){
    runStartCount_ = msg.data;
    if (parkingState_ == FINISHED){
        isStartJourney_ = true;
        //pathRunRequestMsg_ = msg;
    }
}

void runStartTestCallback(const std_msgs::Int32 &msg){
    runStartCount_ = msg.data;
    parkingState_ = TURN_AFTER_MOVING_BACK_TO_JOURNEY;
    parkingStateString_ = std::string("TURN_AFTER_MOVING_BACK_TO_JOURNEY");
}

void requestRunStartCallback(const std_msgs::Empty& msg){
    if (parkingState_ == FINISHED){
        isStartJourney_ = true; 
    }
}

int main(int argc, char **argv)
{
    ROS_INFO("autonomous_parker start\n");
    ros::init(argc, argv, "autonomous_parker");

    ros::NodeHandle nh;
    ros::Rate loop_rate(20);

    imgLaser_ = cv::Mat::zeros( 480, 640, CV_8UC3 ) ;

    ros::Subscriber frontLaserSubscriber = nh.subscribe("/scan_1", 1, frontLaserCallback);

    ros::Subscriber amclPoseSubscriber = nh.subscribe("/amcl_pose", 10, amclPoseCallback);

    ros::Subscriber startAutoParkingSubscriber = nh.subscribe("/start_auto_parking", 1, startAutoParkingCallback);

    ros::Subscriber cancelSubscriber = nh.subscribe("/path_run_cancel_request", 1, cancelCallback);

    ros::Subscriber bleStandBySubscriber = nh.subscribe("/parking_standby_ack", 10, parkingStandbyAckCallback);

    ros::Subscriber stopParkingDockConnectedSubscriber = nh.subscribe("/stop_parking_dock_connected", 10, stopParkingDockConnectedCallback);

    ros::Subscriber sonar1Subscriber = nh.subscribe("/sonar_bottom_fl", 10, sonar1Callback);
    ros::Subscriber sonarFrSubscriber = nh.subscribe("/sonar_bottom_fr", 10, sonarFrCallback);

    ros::Subscriber odomSubscriber = nh.subscribe("/odom", 10, odomCallback);

    ros::Subscriber pathRunRequestSubscriber = nh.subscribe("/path_run_request", 1, pathRunRequestCallback);

    ros::Subscriber exceptionalTermiationBleSubscriber = nh.subscribe("/exceptional_termination_ble", 1, exceptionalTerminationCallback);

    ros::Subscriber isChargingFromBleSubscriber = nh.subscribe("/is_charging_from_ble", 1, isChargingFromBleCallback);    
    ros::Subscriber isChargingFromBatterySubscriber = nh.subscribe("/is_charging_from_battery", 1, isChargingFromBatteryCallback);   

    ros::Subscriber initialDriveForTurnSubscriber = nh.subscribe("/initial_drive_for_turn", 1, initialDriveForTurnCallback);

    ros::Subscriber requestRunStartCountSubscriber = nh.subscribe("/request_run_start", 1, requestRunStartCallback); 

    ros::Subscriber initial_run_start_sub = nh.subscribe("/initial_run_start", 10, initialRunStartCallback); 
    ros::Subscriber run_start_count_sub = nh.subscribe("/run_start_count", 10, runStartCountCallback); 
    ros::Subscriber start_test = nh.subscribe("/run_start_test", 10, runStartTestCallback); 

    ros::Publisher pointMovingCancelPublisher = nh.advertise<actionlib_msgs::GoalID>("/move_base/cancel", 1);

    ros::Publisher pathRunCancelRequestPublisher = nh.advertise<std_msgs::Empty>("/path_run_cancel_request", 1);

    ros::Publisher moveGoalPublisher = nh.advertise<move_base_msgs::MoveBaseActionGoal>("/move_base/goal", 1);
    //ros::Publisher moveGoalPublusher = nh.advertise<geometry_msgs::PoseStamped>("/move_base_simple/goal", 1);

    ros::Publisher parkingStartPublisher = nh.advertise<std_msgs::Int32>("/parking_start", 1);

    ros::Publisher journeyStartToBlePublisher = nh.advertise<std_msgs::Int32>("journey_start_to_ble", 1);

    ros::Publisher moveRequestPublisher = nh.advertise<std_msgs::Int32>("/move_request", 1);

    ros::Publisher isChargingPublisher = nh.advertise<std_msgs::Bool>("/is_charging", 1);

    ros::Publisher variableSpeendOnOffRequestPublisher = nh.advertise<std_msgs::Int32>("/variable_speed_onoff_request" , 1);

    cmdVelPub_ = nh.advertise<geometry_msgs::Twist>("cmd_vel", 1);

    driveCompletedPublisher_ = nh.advertise<std_msgs::String>("/drive_completed", 10);

    ros::Publisher clearFollowWaypointsPublisher = nh.advertise<std_msgs::Empty>("/clear_follow_waypoints", 1);

    ros::Publisher requestShortestGuidePublisher = nh.advertise<std_msgs::Int32>("/request_shortest_guide", 1);

    ros::Publisher requestDisplayPublisher = nh.advertise<std_msgs::Int32>("/request_display", 1);

    ros::Publisher pathRunRequestPublisher = nh.advertise<std_msgs::String>("/path_run_request", 1);

    ros::Publisher initialposeFlyingletPublisher = nh.advertise<std_msgs::Empty>("/initialpose_flyinglet", 1);

    // parkingstate
    ros::Publisher parkingStatePublisher = nh.advertise<std_msgs::String>("/parking_state", 10);
    
    justStartedChargingPublisher_ = nh.advertise<std_msgs::Empty>("/just_started_charging", 1);
    justTakenOutChargingPublisher_ = nh.advertise<std_msgs::Empty>("/just_taken_out_charging", 1);

    resultGradient_ = 0;

    parkingState_ = PARKING_STATE::INITIALIZING;
    
    currentGradient_ = 0;

    currentHorizontalPosition_ = 0;

    forwardToGoToAdjustHorizon_ = 0.0;

    targetGradient_ = 0.0;
    currentDistanceToCharger_ = 0.0;
    centerLidarDistance_ = 0.0;
    targetAngle_ = 0.0;

    homeCentroidXToMoveForward_ = 0.0;
    homeCentroidYToMoveForward_ = 0.0;

    isRequestedStartAutoParking_ = false;

    isRequestedCancel_ = false;

    previousParkingState_ = PARKING_STATE::FINISHED;

    int count = 0 ;

    isParkingStandby_ = false;

    isDockConnected_ = false;

    targetBackMovingDistance_ = 0.5;

    isStartJourney_ = false;

    isCharging_ = false;

    isBleTerminatedExceptionally_ = false;
    theta_ = 0.0;

      
    // hyundai trade 230504
	// parkingPointPose_.header.frame_id = "map";
    // parkingPointPose_.pose.position.x = 15.0254058945;
    // parkingPointPose_.pose.position.y = 46.7729047303;
    // parkingPointPose_.pose.position.z = 0.0;
    // parkingPointPose_.pose.orientation.x = 0.0;
