                        countMoving1 = 0;
                    }
					
                }  

                break;
            }

            case MOVING_TO_PARKING_POINT2 :
            {   
                tf2::Quaternion currentPoseQuaternion(currentAmclPose_.pose.pose.orientation.x, currentAmclPose_.pose.pose.orientation.y, currentAmclPose_.pose.pose.orientation.z ,currentAmclPose_.pose.pose.orientation.w);
                tf2::Quaternion parkingPointQuaternionInverse = parkingPoint2Quaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * parkingPointQuaternionInverse;

                geometry_msgs::Pose relationPose;
                tf2::convert(relationQuaternion, relationPose.orientation);
                
                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::atan2(siny_cosp, cosy_cosp) * RAD2DEG;

                double distance = std::sqrt( (currentAmclPose_.pose.pose.position.x - parkingPoint2Pose_.pose.position.x) * (currentAmclPose_.pose.pose.position.x - parkingPoint2Pose_.pose.position.x)
                                    + (currentAmclPose_.pose.pose.position.y - parkingPoint2Pose_.pose.position.y) * (currentAmclPose_.pose.pose.position.y - parkingPoint2Pose_.pose.position.y) ) ;

                std::cout << "distance : " << distance << "  ,  relativeYaw : " << yaw << std::endl;              

                if ( distance <= 1.0 && std::abs(yaw) <= 20.0){
                    ++countMoving2;
                    if (countMoving2 >= 100){
                        parkingPoint3Pose_.header.stamp = ros::Time::now();
                        move_base_msgs::MoveBaseActionGoal goalMsg;
                        goalMsg.header.frame_id = "map";
                        goalMsg.header.stamp = parkingPoint3Pose_.header.stamp;
                        goalMsg.goal_id.stamp = parkingPoint3Pose_.header.stamp;
                        goalMsg.goal_id.id = std::string("autonomous_parker_") + std::to_string(goalMsg.header.stamp.toSec());
                        goalMsg.goal.target_pose = parkingPoint3Pose_;

                        moveGoalPublisher.publish(goalMsg);
                        parkingState_ = MOVING_TO_PARKING_POINT3;
                        parkingStateString_ = std::string("MOVING_TO_PARKING_POINT3");
                        countMoving2 = 0;
                    }
                }  
                break;
            }

            case MOVING_TO_PARKING_POINT3 :
            {   
                tf2::Quaternion currentPoseQuaternion(currentAmclPose_.pose.pose.orientation.x, currentAmclPose_.pose.pose.orientation.y, currentAmclPose_.pose.pose.orientation.z ,currentAmclPose_.pose.pose.orientation.w);
                tf2::Quaternion parkingPointQuaternionInverse = parkingPoint3Quaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * parkingPointQuaternionInverse;

                geometry_msgs::Pose relationPose;
                tf2::convert(relationQuaternion, relationPose.orientation);
                
                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::atan2(siny_cosp, cosy_cosp) * RAD2DEG;

                double distance = std::sqrt( (currentAmclPose_.pose.pose.position.x - parkingPoint3Pose_.pose.position.x) * (currentAmclPose_.pose.pose.position.x - parkingPoint3Pose_.pose.position.x)
                                    + (currentAmclPose_.pose.pose.position.y - parkingPoint3Pose_.pose.position.y) * (currentAmclPose_.pose.pose.position.y - parkingPoint3Pose_.pose.position.y) ) ;

                std::cout << "distance : " << distance << "  ,  relativeYaw : " << yaw << std::endl;              

                if ( distance <= 0.7 && std::abs(yaw) <= 15.0){
                    ++countMoving3;
                    if (countMoving3 >= 100){
                        parkingPoint4Pose_.header.stamp = ros::Time::now();
                        move_base_msgs::MoveBaseActionGoal goalMsg;
                        goalMsg.header.frame_id = "map";
                        goalMsg.header.stamp = parkingPoint4Pose_.header.stamp;
                        goalMsg.goal_id.stamp = parkingPoint4Pose_.header.stamp;
                        goalMsg.goal_id.id = std::string("autonomous_parker_") + std::to_string(goalMsg.header.stamp.toSec());
                        goalMsg.goal.target_pose = parkingPoint4Pose_;

                        moveGoalPublisher.publish(goalMsg);
                        parkingState_ = MOVING_TO_PARKING_POINT4;
                        parkingStateString_ = std::string("MOVING_TO_PARKING_POINT4");
                        countMoving3 = 0;
                    }
                }  
                break;
            }

            case MOVING_TO_PARKING_POINT4 :
            {   
                tf2::Quaternion currentPoseQuaternion(currentAmclPose_.pose.pose.orientation.x, currentAmclPose_.pose.pose.orientation.y, currentAmclPose_.pose.pose.orientation.z ,currentAmclPose_.pose.pose.orientation.w);
                tf2::Quaternion parkingPointQuaternionInverse = parkingPoint4Quaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * parkingPointQuaternionInverse;

                geometry_msgs::Pose relationPose;
                tf2::convert(relationQuaternion, relationPose.orientation);
                
                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::atan2(siny_cosp, cosy_cosp) * RAD2DEG;

                double distance = std::sqrt( (currentAmclPose_.pose.pose.position.x - parkingPoint4Pose_.pose.position.x) * (currentAmclPose_.pose.pose.position.x - parkingPoint4Pose_.pose.position.x)
                                    + (currentAmclPose_.pose.pose.position.y - parkingPoint4Pose_.pose.position.y) * (currentAmclPose_.pose.pose.position.y - parkingPoint4Pose_.pose.position.y) ) ;

                std::cout << "distance : " << distance << "  ,  relativeYaw : " << yaw << std::endl;              

                if ( distance <= 0.4 && std::abs(yaw) <= 10.0){
                    parkingState_ = INITIAL_MOVING_BACK;
                    parkingStateString_ = std::string("INITIAL_MOVING_BACK");
                    std_msgs::Int32 parkingStartMsg;
                    parkingStartMsg.data = 1;
                    parkingStartPublisher.publish(parkingStartMsg);
                }  
                break;
            }

            case INITIAL_MOVING_BACK : 
            {
                double toStationDistance = std::sqrt( (double)((centroidY_-CENTER_COORDINATES) * (centroidY_-CENTER_COORDINATES))  + (double)((centroidX_-CENTER_COORDINATES) * (centroidX_-CENTER_COORDINATES))  ) * 0.005;
                if (toStationDistance < 0.45){
                    movingTwistMsg.linear.x = -0.05;
                    movingTwistMsg.angular.z = 0.00;
                    cmdVelPub_.publish(movingTwistMsg);
                }
                else {
                    movingTwistMsg.linear.x = 0.00;
                    movingTwistMsg.angular.z = 0.00;
                    cmdVelPub_.publish(movingTwistMsg);
                    parkingState_ = ADJUSTING_YAW;
                    parkingStateString_ = std::string("ADJUSTING_YAW");
                }

                break;
            }
            
            case ADJUSTING_YAW :
            {                
                if (isParkingStandby_){
                    if (currentGradient_ == 0){
                        if (resultGradient_ < 0){
                            currentGradient_ = -1;
                        }
                        else {
                            currentGradient_ = 1;
                        }
                    }

                    if (centroidX_ > 203){
                        movingTwistMsg.linear.x = 0.0;
                        movingTwistMsg.angular.z = 0.06;
                        cmdVelPub_.publish(movingTwistMsg);
                    }
                    else if (centroidX_ < 197){
                        movingTwistMsg.linear.x = 0.0;
                        movingTwistMsg.angular.z = -0.06;
                        cmdVelPub_.publish(movingTwistMsg);
                    }
                    else {
                        parkingState_ = INITIAL_ADJUSTING_FOWARD;
                        parkingStateString_ = std::string("INITIAL_ADJUSTING_FOWARD");
                        //velocity controls
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.0;
                        cmdVelPub_.publish(movingTwistMsg);
                    }                    
                }
                break;
            }

            case INITIAL_ADJUSTING_FOWARD:
            {
                double remainingDistance = std::sqrt( (double)((centroidY_-CENTER_COORDINATES) * (centroidY_-CENTER_COORDINATES))) * 0.005;
                std::cout << "remaining Distance : " << remainingDistance << std::endl;

                if ( remainingDistance <= 0.45){
                    movingTwistMsg.linear.x = 0.0; 
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);
                    parkingState_ = COLLECTING_DATA;
                    parkingStateString_ = std::string("COLLECTING_DATA");
                    break;
                }

                movingTwistMsg.linear.x = 0.06; 
                movingTwistMsg.angular.z = 0.0;
                cmdVelPub_.publish(movingTwistMsg);

                break;
            }

            case COLLECTING_DATA:
            {
                if (count == 50){   
                    
                    double sumCentroidX = 0.0;
                    double sumCentroidY = 0.0;
                    double sumResultGradient = 0.0;
                    for (int i = 0; i < centroidXVector_.size(); ++i){
                        sumCentroidX += centroidXVector_[i];
                    }                   
                    sumCentroidX /= (double)centroidXVector_.size();               

                    for (int i = 0 ; i < centroidYVector_.size(); ++i){
                        sumCentroidY += centroidYVector_[i];                        
                    }
                    sumCentroidY /= (double)centroidYVector_.size();

                    for (int i = 0 ; i< resultGradientVector_.size() ; ++i){
                        sumResultGradient += resultGradientVector_[i];
                    }
                    sumResultGradient /= (double)resultGradientVector_.size();

                    // double backMovingDistance = std::sqrt( (double)((sumCentroidX-CENTER_COORDINATES) * (sumCentroidX-CENTER_COORDINATES)) + 
                    //     (double)((sumCentroidY-CENTER_COORDINATES) * (sumCentroidY-CENTER_COORDINATES))) * 0.01;
                    double toStationDistance = std::sqrt ( (double)( (sumCentroidY-CENTER_COORDINATES) * (sumCentroidY-CENTER_COORDINATES)) +  (double)((sumCentroidY-CENTER_COORDINATES) * (sumCentroidY-CENTER_COORDINATES)) ) * 0.005;

                    std::cout << "to Station Distance : " << toStationDistance << std::endl;
                    std::cout << "center Lidar Distance : " << centerLidarDistance_ << std::endl;
                    
                    if(toStationDistance >=0.5){
                        // if ( std::abs(sumResultGradient) <= 0.025){
                        //     parkingState_ = ADJUSTING_FORWARD;
                        //     parkingStateString_ = std::string("ADJUSTING_FORWARD"); 
                        // }
                    
                        targetGradient_ = sumResultGradient;
                        targetAngle_ = 25.0-5.0;
                        //targetAngle_ = std::abs(std::atan(targetGradient_)) * RAD2DEG;
                        // if (targetGradient_ >= 0){
                        //     targetAngle_ = 25.0;
                        // }
                        // else {
                        //     targetAngle_ = -25.0;
                        // }
                        //startingPose_ = currentAmclPose_;
                        startingOdom_ = currentOdom_;
                        std::cout << "target gradient : " << targetGradient_ << std::endl;

                        double b = std::abs(targetGradient_) * ( ( sumCentroidY - CENTER_COORDINATES) / 2.0) ;
                        theta_ = std::atan( std::abs(targetGradient_) );
                        //forwardToGoToAdjustHorizon_ = toStationDistance / ( 2 * std::cos( std::atan( std::abs(targetGradient_) ) ) ) * 1.3 / 3.0;
                        forwardToGoToAdjustHorizon_ = ((toStationDistance * 2.2 / 4.0) * std::sin(theta_)) / std::cos( DEG2RAD*75.0 - theta_ ) ;

                        std::cout << "forwardToGoToAdjustHorizon_ : " << forwardToGoToAdjustHorizon_ << std::endl;
                        parkingState_ = ADJUSTING_YAW_TO_HORIZONTAL;
                        parkingStateString_ = std::string("ADJUSTING_YAW_TO_HORIZONTAL"); 
                    
                    }

                    else {
                        targetBackMovingDistance_ = 0.5;
                        parkingState_ = MOVING_BACK;
                        parkingStateString_ = std::string("MOVING_BACK");                         
                    }

                    count = 0;
                    centroidXVector_.clear();
                    centroidYVector_.clear();
                    resultGradientVector_.clear();
                    break;
                }
                ++count;                
                centroidXVector_.push_back(centroidX_);
                centroidYVector_.push_back(centroidY_);
                resultGradientVector_.push_back(resultGradient_);
                
                break;
            }

            case ADJUSTING_YAW_TO_HORIZONTAL :
            {
                tf2::Quaternion currentPoseQuaternion(currentOdom_.pose.pose.orientation.x, currentOdom_.pose.pose.orientation.y, currentOdom_.pose.pose.orientation.z ,currentOdom_.pose.pose.orientation.w);
                tf2::Quaternion startingPoseQuaternion(startingOdom_.pose.pose.orientation.x, startingOdom_.pose.pose.orientation.y, startingOdom_.pose.pose.orientation.z, startingOdom_.pose.pose.orientation.w);
                tf2::Quaternion startingPoseQuaternionInverse = startingPoseQuaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * startingPoseQuaternionInverse;

                geometry_msgs::Pose relationPose;

                tf2::convert(relationQuaternion, relationPose.orientation);
                
                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::abs(std::atan2(siny_cosp, cosy_cosp) * RAD2DEG);
                double currentProcessingGradient = ( double(centroidY_ - CENTER_COORDINATES) / double(centroidX_ - CENTER_COORDINATES) );

                std::cout << "currentProcessingGradient : " << currentProcessingGradient << "  , target : " << (-1.0 / targetGradient_) << std::endl;
                std::cout << " relativeYaw : " << yaw << std::endl;             

                if (targetGradient_ > 0.0){
                    
                    if ( yaw >= targetAngle_ ) {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.0;
                        cmdVelPub_.publish(movingTwistMsg);
                        currentDistanceToCharger_ = std::sqrt((centroidX_ - CENTER_COORDINATES) * (centroidX_ - CENTER_COORDINATES) + (centroidY_ - CENTER_COORDINATES) * (centroidY_ - CENTER_COORDINATES)) * 0.005;
                        startingOdom_ = currentOdom_;
                        parkingState_ = ADJUSTING_FORWARD_TO_HORIZONTAL;
                        parkingStateString_ = std::string("ADJUSTING_FORWARD_TO_HORIZONTAL");                
                    }
                    else {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.06;
                        cmdVelPub_.publish(movingTwistMsg);
                    }
                }
                else {
                    if ( yaw >= targetAngle_ ) {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.0;
                        cmdVelPub_.publish(movingTwistMsg);
                        currentDistanceToCharger_ = std::sqrt((centroidX_ - CENTER_COORDINATES) * (centroidX_ - CENTER_COORDINATES) + (centroidY_ - CENTER_COORDINATES) * (centroidY_ - CENTER_COORDINATES)) * 0.005;
                        startingOdom_ = currentOdom_;
                        parkingState_ = ADJUSTING_FORWARD_TO_HORIZONTAL;
                        parkingStateString_ = std::string("ADJUSTING_FORWARD_TO_HORIZONTAL");                
                    }
                    else {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = -0.06;
                        cmdVelPub_.publish(movingTwistMsg);
                    }
                }

                break;
            }

            case ADJUSTING_FORWARD_TO_HORIZONTAL:
            {
                double processGradient = ( double(centroidY_ - CENTER_COORDINATES) / double(centroidX_ - CENTER_COORDINATES) );
                double odomXDiffer = currentOdom_.pose.pose.position.x - startingOdom_.pose.pose.position.x;
                double odomYDiffer = currentOdom_.pose.pose.position.y - startingOdom_.pose.pose.position.y;
                double distanceTraveled = std::sqrt(odomXDiffer * odomXDiffer + odomYDiffer * odomYDiffer);
                
                double distanceRemaining = std::sqrt((centroidX_ - CENTER_COORDINATES) * (centroidX_ - CENTER_COORDINATES) + (centroidY_ - CENTER_COORDINATES) * (centroidY_ - CENTER_COORDINATES)) * 0.005;
                
                std::cout << "distanceTraveled : " << distanceTraveled << "  , forwardToGo : " << forwardToGoToAdjustHorizon_ << std::endl;
                if ( distanceTraveled >= forwardToGoToAdjustHorizon_){
                    movingTwistMsg.linear.x = 0.0; 
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);
                    parkingState_ = ADJUSTING_YAW_AFTER_HORIZONTAL_FORWARD;
                    parkingStateString_ = std::string("ADJUSTING_YAW_AFTER_HORIZONTAL_FORWARD");
                    // targetAngle_ = -25.0;
                    targetGradient_ = targetGradient_ * -1.0;
                    targetAngle_ = targetAngle_ + RAD2DEG*theta_ -5.0;
                    startingOdom_ = currentOdom_;
                    break;
                }

                movingTwistMsg.linear.x = 0.05; 
                movingTwistMsg.angular.z = 0.0;
                cmdVelPub_.publish(movingTwistMsg);
                
                break;
            }

            case ADJUSTING_YAW_AFTER_HORIZONTAL_FORWARD:
            {                
                tf2::Quaternion currentPoseQuaternion(currentOdom_.pose.pose.orientation.x, currentOdom_.pose.pose.orientation.y, currentOdom_.pose.pose.orientation.z ,currentOdom_.pose.pose.orientation.w);
                tf2::Quaternion startingPoseQuaternion(startingOdom_.pose.pose.orientation.x, startingOdom_.pose.pose.orientation.y, startingOdom_.pose.pose.orientation.z, startingOdom_.pose.pose.orientation.w);
                tf2::Quaternion startingPoseQuaternionInverse = startingPoseQuaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * startingPoseQuaternionInverse;

                geometry_msgs::Pose relationPose;

                tf2::convert(relationQuaternion, relationPose.orientation);
                
                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::abs(std::atan2(siny_cosp, cosy_cosp) * RAD2DEG);
                double currentProcessingGradient = ( double(centroidY_ - CENTER_COORDINATES) / double(centroidX_ - CENTER_COORDINATES) );

                std::cout << "currentProcessingGradient : " << currentProcessingGradient << "  , target : " << (-1.0 / targetGradient_) << std::endl;
                std::cout << " relativeYaw : " << yaw << std::endl;             

                if (targetGradient_ > 0.0){
                    
                    if ( yaw >= targetAngle_ ) {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.0;
                        cmdVelPub_.publish(movingTwistMsg);
                        currentDistanceToCharger_ = std::sqrt((centroidX_ - CENTER_COORDINATES) * (centroidX_ - CENTER_COORDINATES) + (centroidY_ - CENTER_COORDINATES) * (centroidY_ - CENTER_COORDINATES)) * 0.005;
                        startingOdom_ = currentOdom_;
                        parkingState_ = ADJUSTING_YAW_PRECISELY_AFTER_HORIZONTAL_FORWARD;
                        parkingStateString_ = std::string("ADJUSTING_YAW_PRECISELY_AFTER_HORIZONTAL_FORWARD");                
                    }
                    else {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.06;
                        cmdVelPub_.publish(movingTwistMsg);
                    }
                }
                else {
                    if ( yaw >= targetAngle_ ) {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = 0.0;
                        cmdVelPub_.publish(movingTwistMsg);
                        currentDistanceToCharger_ = std::sqrt((centroidX_ - CENTER_COORDINATES) * (centroidX_ - CENTER_COORDINATES) + (centroidY_ - CENTER_COORDINATES) * (centroidY_ - CENTER_COORDINATES)) * 0.005;
                        startingOdom_ = currentOdom_;
                        parkingState_ = ADJUSTING_YAW_PRECISELY_AFTER_HORIZONTAL_FORWARD;
                        parkingStateString_ = std::string("ADJUSTING_YAW_PRECISELY_AFTER_HORIZONTAL_FORWARD");                
                    }
                    else {
                        movingTwistMsg.linear.x = 0.0; 
                        movingTwistMsg.angular.z = -0.06;
                        cmdVelPub_.publish(movingTwistMsg);
                    }
                }

                break;
            }

            case ADJUSTING_YAW_PRECISELY_AFTER_HORIZONTAL_FORWARD :
            {
                if (centroidX_ > 205){
                    movingTwistMsg.linear.x = 0.0;
                    movingTwistMsg.angular.z = 0.06;
                    cmdVelPub_.publish(movingTwistMsg);
                }
                else if (centroidX_ < 195){
                    movingTwistMsg.linear.x = 0.0;
                    movingTwistMsg.angular.z = -0.06;
                    cmdVelPub_.publish(movingTwistMsg);
                }
                else {

                    if (countOfAttemptsToAdjustYaw == 0){
                        targetBackMovingDistance_ = 0.45;
                        parkingState_ = MOVING_BACK;
                        parkingStateString_ = std::string("MOVING_BACK");
                        ++countOfAttemptsToAdjustYaw;
                    }
                    else if (countOfAttemptsToAdjustYaw == 1){
                        parkingState_ = ADJUSTING_FORWARD;
                        parkingStateString_ = std::string("ADJUSTING_FORWARD");
                        countOfAttemptsToAdjustYaw = 0;
                    }
                    //parkingState_ = ADJUSTING_FORWARD;
                    //parkingStateString_ = std::string("ADJUSTING_FORWARD");
                    //velocity controls
                    movingTwistMsg.linear.x = 0.0; 
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);
                }
                break;
            }

            case ADJUSTING_FORWARD:
            {
                double distanceRemaining = std::sqrt( ((double)centroidX_ - (double)CENTER_COORDINATES) * ((double)centroidX_ - (double)CENTER_COORDINATES) + ((double)centroidY_ - (double)CENTER_COORDINATES) * ((double)centroidY_ - (double)CENTER_COORDINATES) ) * 0.005;
                //double distanceRemaining = centerLidarDistance_;
                //if (distanceRemaining <= 7.0 || isDockConnected_){
                if (isDockConnected_){
                    movingTwistMsg.linear.x = 0.0; 
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);
                    parkingState_ = FINISHED;
                    parkingStateString_ = std::string("FINISHED");

                    std_msgs::String stringMsg;
                    stringMsg.data = "charging_point";
                    driveCompletedPublisher_.publish(stringMsg);
                    //isCharging_ = true;
                    closeButNotConnectedCount_ = 0;

                    break;
                }

                // if (centroidX_ < 193 || centroidX_ > 207){
                //     movingTwistMsg.linear.x = 0.0; 
                //     movingTwistMsg.angular.z = 0.0;
                //     cmdVelPub_.publish(movingTwistMsg);
                //     targetBackMovingDistance_ = 0.6;
                //     // startingOdom_.pose.pose.position.x = currentOdom_.pose.pose.position.x;
                //     // startingOdom_.pose.pose.position.y = currentOdom_.pose.pose.position.y;
                //     // startingOdom_.pose.pose.position.z = 0.0;
                //     parkingState_ = MOVING_BACK;
                //     parkingStateString_ = std::string("MOVING_BACK");
                //     break;
                // }

                //std::cout << "distanceRemaining : " << distanceRemaining << "   sonarFl : " << sonarFlRange_ << "   sonarFr : " << sonarFrRange_ << std::endl;

                // if (distnaceRemainingToCenter_ <= 0.12){
                //     ++closeButNotConnectedCount_;                    
                // }

                if (closeButNotConnectedCount_ == 1000)
                {
                    movingTwistMsg.linear.x = 0.0; 
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);
                    targetBackMovingDistance_ = 0.5;
                    // startingOdom_.pose.pose.position.x = currentOdom_.pose.pose.position.x;
                    // startingOdom_.pose.pose.position.y = currentOdom_.pose.pose.position.y;
                    // startingOdom_.pose.pose.position.z = 0.0;
                    parkingState_ = MOVING_BACK;
                    parkingStateString_ = std::string("MOVING_BACK");
                    closeButNotConnectedCount_ = 0;
                }
                
                movingTwistMsg.linear.x = 0.03; 
                if (distanceRemaining <=15.0){
                    movingTwistMsg.linear.x = 0.024; 
                    ++closeButNotConnectedCount_;
                }
                movingTwistMsg.angular.z = 0.0;
                cmdVelPub_.publish(movingTwistMsg);
                
                break;
            }            

            case FINISHED :
            {                

                movingTwistMsg.linear.x = 0.0; 
                movingTwistMsg.angular.z = 0.0;
                cmdVelPub_.publish(movingTwistMsg);

                if (finishCount == 100){
                    nh.setParam("/vel_cmd_node/reset_odometry", 1 );

                }
                else if (finishCount == 200 ){
                    std_msgs::Empty emptyMsg;
                    initialposeFlyingletPublisher.publish(emptyMsg);
                }
                else if (finishCount == 300){
                    nh.setParam("/vel_cmd_node/reset_odometry", 0);
                }
                else if (finishCount == 302){
                    finishCount = 301;
                }
                ++finishCount;


                closeButNotConnectedCount_ = 0;
                if (isStartJourney_){
                    //pause
                    std_msgs::Int32 msg;
                    msg.data = 1;
                    moveRequestPublisher.publish(msg);
                    targetBackMovingDistance_ = 0.8;
                    startingOdom_.pose.pose.position.x = currentOdom_.pose.pose.position.x;
                    startingOdom_.pose.pose.position.y = currentOdom_.pose.pose.position.y;
                    startingOdom_.pose.pose.position.z = 0.0;
                    parkingState_ = MOVING_BACK_TO_JOURNEY;
                    parkingStateString_ = std::string("MOVING_BACK_TO_JOURNEY");
                    count = 0;
                    isCharging_ =false;
                    finishCount = 0;
                    break;
                }


                if (isDockConnected_){
                    count = 0;
                    //finishCount = 0;
                    break;
                }
                
                if (count == 200){
                    if (!isDockConnected_){
                        startingOdom_.pose.pose.position.x = currentOdom_.pose.pose.position.x;
                        startingOdom_.pose.pose.position.y = currentOdom_.pose.pose.position.y;
                        startingOdom_.pose.pose.position.z = 0.0;
                        targetBackMovingDistance_ = 0.7;
                        parkingState_ = MOVING_BACK;
                        parkingStateString_ = std::string("MOVING_BACK");
                        //isCharging_ =false;
                        count = 0;
                        finishCount =0 ;
                    }
                    break;
                }

                

                ++count ;
                break;
            }

            case MOVING_BACK :
            {   
                // double backMovingDistance = std::sqrt ( (startingOdom_.pose.pose.position.x - currentOdom_.pose.pose.position.x) * (startingOdom_.pose.pose.position.x - currentOdom_.pose.pose.position.x) + 
                //     (startingOdom_.pose.pose.position.y - currentOdom_.pose.pose.position.y) * (startingOdom_.pose.pose.position.y - currentOdom_.pose.pose.position.y) );

                // double backMovingDistance = std::sqrt( (double)( (centroidX_-CENTER_COORDINATES) * (centroidX_-CENTER_COORDINATES)) + (double)((centroidY_-CENTER_COORDINATES) * (centroidY_-CENTER_COORDINATES))) * 0.01;
                double backMovingDistance = std::sqrt( (double)((centroidY_-CENTER_COORDINATES) * (centroidY_-CENTER_COORDINATES))  + (double)((centroidX_-CENTER_COORDINATES) * (centroidX_-CENTER_COORDINATES))  ) * 0.005;
                //double backMovingDistance = centerLidarDistance_;
                std::cout << "backMovingDistance : " << backMovingDistance << std::endl;

                if ( backMovingDistance >= targetBackMovingDistance_){
                    movingTwistMsg.linear.x = 0.0; 
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);
                    // parkingState_ = COLLECTING_DATA;
                    // parkingStateString_ = std::string("COLLECTING_DATA");
                    parkingState_ = INITIAL_MOVING_BACK;
                    parkingStateString_ = std::string("INITIAL_MOVING_BACK");
                    break;
                }

                movingTwistMsg.linear.x = -0.06;
                movingTwistMsg.angular.z = 0.0;
                cmdVelPub_.publish(movingTwistMsg);

                break;
            }

            case MOVING_BACK_TO_JOURNEY:
            {
                // double backMovingDistance = std::sqrt ( (startingOdom_.pose.pose.position.x - currentOdom_.pose.pose.position.x) * (startingOdom_.pose.pose.position.x - currentOdom_.pose.pose.position.x) + 
                //     (startingOdom_.pose.pose.position.y - currentOdom_.pose.pose.position.y) * (startingOdom_.pose.pose.position.y - currentOdom_.pose.pose.position.y) );
                //double backMovingDistance = std::sqrt( (double)((centroidX_-CENTER_COORDINATES) * (centroidX_-CENTER_COORDINATES)) + (double)((centroidY_-CENTER_COORDINATES) * (centroidY_-CENTER_COORDINATES))) * 0.01;

                double xDiff = currentOdom_.pose.pose.position.x - startingOdom_.pose.pose.position.x;
                double yDiff = currentOdom_.pose.pose.position.y - startingOdom_.pose.pose.position.y;
                double backMovingDistance = std::sqrt( xDiff*xDiff + yDiff*yDiff ) ;

                std::cout << "backMovingDistance : " << backMovingDistance << std::endl;

                if ( backMovingDistance >= targetBackMovingDistance_){
                    movingTwistMsg.linear.x = 0.0;
                    movingTwistMsg.angular.z = 0.0;
                    cmdVelPub_.publish(movingTwistMsg);

                    //resume
                    // std_msgs::Int32 msg;
                    // msg.data = 2;
                    // moveRequestPublisher.publish(msg);

					// msg.data = 1;
                    // journeyStartToBlePublisher.publish(msg);
                    // parkingState_ = INITIALIZING;
                    // parkingStateString_ = std::string("INITIALIZING");
					
					// std_msgs::Int32 intMsg;
					// intMsg.data = 1;
					// variableSpeendOnOffRequestPublisher.publish(intMsg);
                    parkingState_ = TURN_AFTER_MOVING_BACK_TO_JOURNEY;
                    parkingStateString_ = std::string("TURN_AFTER_MOVING_BACK_TO_JOURNEY");

                    break;
                }

                movingTwistMsg.linear.x = -0.06; 
                movingTwistMsg.angular.z = 0.0;
                cmdVelPub_.publish(movingTwistMsg);

                break;
            }

            case TURN_AFTER_MOVING_BACK_TO_JOURNEY:
            {
                tf2::Quaternion currentPoseQuaternion(currentAmclPose_.pose.pose.orientation.x, currentAmclPose_.pose.pose.orientation.y, currentAmclPose_.pose.pose.orientation.z ,currentAmclPose_.pose.pose.orientation.w);
                tf2::Quaternion backMovedPointQuaternionInverse = parkingPoint2Quaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * backMovedPointQuaternionInverse;

                geometry_msgs::Pose relationPose;

                tf2::convert(relationQuaternion, relationPose.orientation);
                
                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::atan2(siny_cosp, cosy_cosp) * RAD2DEG;

                if ( std::abs(yaw) >= 120){
                    // 기존의 INITIALIZING 전환 대신 EXIT_POINT1으로 전환
                    exitPoint1Pose_.header.stamp = ros::Time::now();
                    move_base_msgs::MoveBaseActionGoal goalMsg;
                    goalMsg.header.frame_id = "map";
                    goalMsg.header.stamp = exitPoint1Pose_.header.stamp;
                    goalMsg.goal_id.stamp = exitPoint1Pose_.header.stamp;
                    goalMsg.goal_id.id = std::string("autonomous_parker_") + std::to_string(goalMsg.header.stamp.toSec());
                    goalMsg.goal.target_pose = exitPoint1Pose_;

                    moveGoalPublisher.publish(goalMsg);
                    parkingState_ = MOVING_TO_EXIT_POINT1;
                    parkingStateString_ = std::string("MOVING_TO_EXIT_POINT1");
                }

                movingTwistMsg.linear.x = 0.0;
                movingTwistMsg.angular.z = -0.1;
                cmdVelPub_.publish(movingTwistMsg);
                break;

            }

            case MOVING_TO_EXIT_POINT1:
            {
                tf2::Quaternion currentPoseQuaternion(
                    currentAmclPose_.pose.pose.orientation.x,
                    currentAmclPose_.pose.pose.orientation.y,
                    currentAmclPose_.pose.pose.orientation.z,
                    currentAmclPose_.pose.pose.orientation.w);
                tf2::Quaternion exitPointQuaternionInverse = exitPoint1Quaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * exitPointQuaternionInverse;

                geometry_msgs::Pose relationPose;
                tf2::convert(relationQuaternion, relationPose.orientation);

                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::atan2(siny_cosp, cosy_cosp) * RAD2DEG;

                double distance = std::sqrt(
                    (currentAmclPose_.pose.pose.position.x - exitPoint1Pose_.pose.position.x) *
                    (currentAmclPose_.pose.pose.position.x - exitPoint1Pose_.pose.position.x) +
                    (currentAmclPose_.pose.pose.position.y - exitPoint1Pose_.pose.position.y) *
                    (currentAmclPose_.pose.pose.position.y - exitPoint1Pose_.pose.position.y));

                std::cout << "EXIT1 distance : " << distance << "  ,  relativeYaw : " << yaw << std::endl;

                // 중간 경유지이므로 조건 다소 느슨하게
                if (distance <= 0.5 && std::abs(yaw) <= 20.0) {
                    ++countExitMoving1;
                    if (countExitMoving1 >= 100) {
                        exitPoint2Pose_.header.stamp = ros::Time::now();
                        move_base_msgs::MoveBaseActionGoal goalMsg;
                        goalMsg.header.frame_id = "map";
                        goalMsg.header.stamp = exitPoint2Pose_.header.stamp;
                        goalMsg.goal_id.stamp = exitPoint2Pose_.header.stamp;
                        goalMsg.goal_id.id = std::string("autonomous_parker_") + std::to_string(goalMsg.header.stamp.toSec());
                        goalMsg.goal.target_pose = exitPoint2Pose_;

                        moveGoalPublisher.publish(goalMsg);
                        parkingState_ = MOVING_TO_EXIT_POINT2;
                        parkingStateString_ = std::string("MOVING_TO_EXIT_POINT2");
                        countExitMoving1 = 0;
                    }
                }
                break;
            }

            case MOVING_TO_EXIT_POINT2:
            {
                tf2::Quaternion currentPoseQuaternion(
                    currentAmclPose_.pose.pose.orientation.x,
                    currentAmclPose_.pose.pose.orientation.y,
                    currentAmclPose_.pose.pose.orientation.z,
                    currentAmclPose_.pose.pose.orientation.w);
                tf2::Quaternion exitPointQuaternionInverse = exitPoint2Quaternion.inverse();
                tf2::Quaternion relationQuaternion = currentPoseQuaternion * exitPointQuaternionInverse;

                geometry_msgs::Pose relationPose;
                tf2::convert(relationQuaternion, relationPose.orientation);

                double siny_cosp = 2 * (relationPose.orientation.w * relationPose.orientation.z);
                double cosy_cosp = 1 - 2 * (relationPose.orientation.z * relationPose.orientation.z);
                double yaw = std::atan2(siny_cosp, cosy_cosp) * RAD2DEG;

                double distance = std::sqrt(
                    (currentAmclPose_.pose.pose.position.x - exitPoint2Pose_.pose.position.x) *
                    (currentAmclPose_.pose.pose.position.x - exitPoint2Pose_.pose.position.x) +
                    (currentAmclPose_.pose.pose.position.y - exitPoint2Pose_.pose.position.y) *
                    (currentAmclPose_.pose.pose.position.y - exitPoint2Pose_.pose.position.y));

                std::cout << "EXIT2 distance : " << distance << "  ,  relativeYaw : " << yaw << std::endl;

                // 마지막 포인트이므로 엄격하게
                if (distance <= 0.3 && std::abs(yaw) <= 10.0) {
                    ++countExitMoving2;
                    if (countExitMoving2 >= 100) {
                        // 경로 파일 로드 및 주행 복귀
                        std_msgs::String pathMsg;
                        pathMsg.data = "9900office_241210_v3_4.csv";
                        pathRunRequestPublisher.publish(pathMsg);

                        std_msgs::Int32 msg;
                        msg.data = 1;
                        journeyStartToBlePublisher.publish(msg);

                        parkingState_ = INITIALIZING;
                        parkingStateString_ = std::string("INITIALIZING");
                        countExitMoving2 = 0;
                    }
                }
                break;
            }




        }        

        if (isRequestedCancel_){
            count = 0;
            parkingState_ = INITIALIZING;
            parkingStateString_ = std::string("INITIALIZING");
            movingTwistMsg.linear.x = 0.0; 
            movingTwistMsg.angular.z = 0.0;
            cmdVelPub_.publish(movingTwistMsg);

            //isCharging_ = false;

            std_msgs::Int32 msg;
            msg.data = 1;
            journeyStartToBlePublisher.publish(msg);
        }

        if (previousParkingState_ != parkingState_){
            std::cout << "parkingState : " << parkingStateString_ << std::endl;

            std_msgs::String stateMsg;
            stateMsg.data = parkingStateString_;
            parkingStatePublisher.publish(stateMsg);

        }
                 
        previousParkingState_ = parkingState_;

        std_msgs::Bool isChargingMsg;
        isChargingMsg.data = isCharging_;
        isChargingPublisher.publish(isChargingMsg);
        

        
        // vc >> img;
        // if(img.empty()) {
        //     break;
        // }

        //cv::imshow("cam", img);
        
        // cv::Mat imgOriginal;
        // bool bSuccess = vc.read(imgOriginal);

        // if (!bSuccess){
        //     std::cout << "Cannot read a frame from video stream" << std::endl;
        //     break;
        // }

        // cv::Mat imgHSV;
        // cv::cvtColor(imgOriginal, imgHSV, cv::COLOR_BGR2HSV); //Convert the captured frame from BGR to HSV
        
        // cv::Mat imgThresholded;

        // cv::inRange(imgHSV, cv::Scalar(iLowH, iLowS, iLowV), cv::Scalar(iHighH, iHighS, iHighV), imgThresholded); //Threshold the image
        // cv::erode(imgThresholded, imgThresholded, cv::getStructuringElement(cv::MORPH_ELLIPSE, cv::Size(5, 5)) );
        // cv::dilate( imgThresholded, imgThresholded, cv::getStructuringElement(cv::MORPH_ELLIPSE, cv::Size(5, 5)) ); 

        // //morphological closing (removes small holes from the foreground)
        // cv::dilate( imgThresholded, imgThresholded, cv::getStructuringElement(cv::MORPH_ELLIPSE, cv::Size(5, 5)) ); 
        // cv::erode(imgThresholded, imgThresholded, cv::getStructuringElement(cv::MORPH_ELLIPSE, cv::Size(5, 5)) );

        // //Calculate the moments of the thresholded image
        // cv::Moments oMoments = cv::moments(imgThresholded);

        // double dM01 = oMoments.m01;
        // double dM10 = oMoments.m10;
        // double dArea = oMoments.m00;

        // // if the area <= 10000, I consider that the there are no object in the image and it's because of the noise, the area is not zero 
        // if (dArea > 10000)
        // {
        // //calculate the position of the ball
        // int posX = dM10 / dArea;
        // int posY = dM01 / dArea;        
                
        // if (iLastX >= 0 && iLastY >= 0 && posX >= 0 && posY >= 0)
        // {
        //     //Draw a red line from the previous point to the current point
        //     cv::line(imgLines, cv::Point(posX, posY), cv::Point(iLastX, iLastY), cv::Scalar(0,0,255), 2);
        // }

        // iLastX = posX;
        // iLastY = posY;
        // }

        // cv::imshow("Thresholded Image", imgThresholded); //show the thresholded image

        // imgOriginal = imgOriginal + imgLines;
        // cv::imshow("Original", imgOriginal); //show the original image

        if (cv::waitKey(30) == 27){
            break;
        }

        ros::spinOnce();
        loop_rate.sleep();
    }

    cv::destroyAllWindows();

    return 0;
}
