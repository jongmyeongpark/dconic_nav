void frontLaserCallback(const sensor_msgs::LaserScan& laserMsg){
    
    if (parkingState_ == INITIALIZING || parkingState_ == IDLE){
        return;
    }    

    //centerLidarDistance_ = laserMsg.ranges[laserMsg.ranges.size()/2];
    centerLidarDistance_ = 0.0;
    for (int i = laserMsg.ranges.size()/2 -7 ; i < laserMsg.ranges.size()/2 +7 ;++i){
        centerLidarDistance_ += laserMsg.ranges[i]; 
    }
    centerLidarDistance_ /= 14.0;

    //std::cout << "center Lidar Distance : " << centerLidarDistance_ << std::endl;

    //std::cout << "front laser Callback" << std::endl;
    imgLaser_ = cv::Mat::zeros( 480, 640, CV_8UC3 ) ;

    for(int i = laserMsg.ranges.size()*3/10 ; i < laserMsg.ranges.size()*7/10 ; ++i){
        //laser_range_vector.push_back(msg.ranges[i]); 

        if ( laserMsg.ranges[i] < 1.0 && laserMsg.ranges[i] >= 0.05 ){
            
            double r = laserMsg.ranges[i] * 200.0;
            double theta = 180.0 / ((double)laserMsg.ranges.size()) * ((double)(laserMsg.ranges.size() - i));

            double x = r * std::cos(DEG2RAD * theta) + CENTER_COORDINATES;
            double y = r * std::sin(DEG2RAD * theta) + CENTER_COORDINATES;

            cv::Vec3b & color = imgLaser_.at<cv::Vec3b>(y,x);

            //... do something to the color ....
            color[0] = 255;
            color[1] = 255;
            color[2] = 255;

            //std::cout << "i : " << i << ", range : " << laserMsg.ranges[i] << ", x : " << x << ", y : " << y << std::endl;

            // set pixel
            imgLaser_.at<cv::Vec3b>(cv::Point(x,y)) = color;
            imgLaser_.at<cv::Vec3b>(cv::Point(x+1,y)) = color;
            imgLaser_.at<cv::Vec3b>(cv::Point(x,y+1)) = color;
            imgLaser_.at<cv::Vec3b>(cv::Point(x+1,y+1)) = color;
            
            // imgLaser_.at<cv::Vec3b>(cv::Point(x+2,y)) = color;
            // imgLaser_.at<cv::Vec3b>(cv::Point(x,y+2)) = color;
            // imgLaser_.at<cv::Vec3b>(cv::Point(x+1,y+2)) = color;
            // imgLaser_.at<cv::Vec3b>(cv::Point(x+2,y+1)) = color;
            // imgLaser_.at<cv::Vec3b>(cv::Point(x+2,y+2)) = color;
            //if you copy value            
        }    
    }    

    cv::Mat result2, img_gray, img_threshold;
    
    cv::dilate(imgLaser_, result2, cv::Mat()); // 침식된 영상에 대한 팽창

    cv::erode(result2, result2, cv::Mat()); // 원 영상을 침식

    cv::dilate(result2, result2, cv::Mat()); // 침식된 영상에 대한 팽창
    cv::dilate(result2, result2, cv::Mat()); // 침식된 영상에 대한 팽창
    cv::dilate(result2, result2, cv::Mat()); // 침식된 영상에 대한 팽창

    cv::cvtColor(result2, img_gray, cv::COLOR_BGR2GRAY);

    cv::threshold(img_gray, img_threshold, 100, 255, cv::THRESH_BINARY);
    //cv::imshow("Laser Image threshold", img_threshold);

    cv::Mat img_labels, stats, centroids;
    int numOfLables = cv::connectedComponentsWithStats(img_threshold, img_labels, stats, centroids, 8, CV_32S);

    if (numOfLables < 2){
        return;
    }

    //std::cout << "connectedComponent num : " << numOfLables << std::endl;
    int bigClosestLabel = 0;

    if (sonarRange_ > 0.30){
        std::vector<int> bigComponentLables;        
        for (int i = 1 ; i < numOfLables ; ++i){
            int width = stats.at<int>(i, cv::CC_STAT_WIDTH);
            int height = stats.at<int>(i, cv::CC_STAT_HEIGHT);

            int area = width * height;
            // std::cout << "area : " << area << std::endl;

            if (area > 700){
                bigComponentLables.push_back(i);
            }
        }    

        if (bigComponentLables.size() > 0){
            bigClosestLabel = bigComponentLables[0];
            double bigClosestDistance = std::numeric_limits<double>::max();
            for (int i = 0; i < bigComponentLables.size() ; ++i){
                int label = bigComponentLables[i];
                int centroidXTemp = centroids.at<double>(label, 0);
                int centroidYTemp = centroids.at<double>(label, 1); 
                double distance = std::sqrt( (( (double)centroidXTemp - (double)CENTER_COORDINATES ) * ( (double)centroidXTemp - (double)CENTER_COORDINATES )) + (( (double)centroidYTemp - (double)CENTER_COORDINATES ) * ( (double)centroidYTemp - (double)CENTER_COORDINATES )) );
                if (distance < bigClosestDistance){
                    bigClosestLabel = label;
                    bigClosestDistance = distance;
                }
            }
        }
        else {
            return;
        }
    }
    else{
        double biggestArea = std::numeric_limits<double>::min();
        for (int i = 1 ; i < numOfLables ; ++i){
            int width = stats.at<int>(i, cv::CC_STAT_WIDTH);
            int height = stats.at<int>(i, cv::CC_STAT_HEIGHT);

            int area = width * height;

            if (area > biggestArea){
                biggestArea = area;
                bigClosestLabel = i;
            }
        }    
    }
    

    // int biggestLabel = 1;
    // double biggestArea = std::numeric_limits<double>::min();
    
    // for (int i = 1 ; i < numOfLables ; ++i){
    //     int width = stats.at<int>(i, cv::CC_STAT_WIDTH);
    //     int height = stats.at<int>(i, cv::CC_STAT_HEIGHT);

    //     int area = width * height;

    //     if (area > biggestArea){
    //         biggestLabel = i;
    //         biggestArea = area;
    //     }
        
    // }

    //int biggestWidth = stats.at<int>(biggestLabel, cv::CC_STAT_WIDTH);
    //int biggestHeight = stats.at<int>(biggestLabel, cv::CC_STAT_HEIGHT);

    //std::cout << "w : " << biggestWidth << "  , h : " << biggestHeight << "   *= " << biggestWidth*biggestHeight <<std::endl;

    int centroidX = centroids.at<double>(bigClosestLabel, 0);
    int centroidY = centroids.at<double>(bigClosestLabel, 1); 

    if (centroidXList_.size() >= 5){
        centroidXList_.pop_front();
    }

    if (centroidYList_.size() >= 5){
        centroidYList_.pop_front();
    }

    centroidXList_.push_back(centroidX);
    centroidYList_.push_back(centroidY);

    std::list<double>::iterator iter;

    double centroidXtemp = 0.0;    
    iter = centroidXList_.begin();
    while( iter != centroidXList_.end() ){
        centroidXtemp += (*iter);       
        ++iter;
    }
    centroidX_ = centroidXtemp / centroidXList_.size();    

    double centroidYtemp = 0.0;
    iter = centroidYList_.begin();
    while( iter != centroidYList_.end() ){
        centroidYtemp += (*iter);       
        ++iter;
    }
    centroidY_ = centroidYtemp / centroidYList_.size();    

    //centroidX_ = centroids.at<double>(bigClosestLabel, 0);
    //centroidY_ = centroids.at<double>(bigClosestLabel, 1); 

    cv::circle(result2, cv::Point(centroidX_, centroidY_), 5, cv::Scalar(0, 255, 0), 1);

    int area = stats.at<int>(bigClosestLabel, cv::CC_STAT_AREA);
    int left = stats.at<int>(bigClosestLabel, cv::CC_STAT_LEFT);
    int top = stats.at<int>(bigClosestLabel, cv::CC_STAT_TOP);
    int width = stats.at<int>(bigClosestLabel, cv::CC_STAT_WIDTH);
    int height = stats.at<int>(bigClosestLabel, cv::CC_STAT_HEIGHT);

    cv::rectangle(result2, cv::Point(left, top), cv::Point(left + width, top + height), cv::Scalar(0, 0, 255), 1);

    std::vector<cv::Point> recognizedPoints;

    for (int y = top ; y < top + height ; ++y){
        for (int x = left; x < left + width ; ++x){
            if (img_threshold.at<uchar>(y,x) > 0){
                recognizedPoints.push_back(cv::Point(x,y));
            }
        }
    }

    //std::cout << "recog length : " << recognizedPoints.size() << std::endl;
    //cv::Vec4f lines;
    if (recognizedPoints.size() > 0 ){
        std::vector<float> lines;
        cv::fitLine(recognizedPoints,lines,2,1,0.01,0.01);

        if (gradientList_.size() >=10){
            gradientList_.pop_front();
        }
        gradientList_.push_back( (lines[1]/lines[0]) );
        double resultGradientTemp = 0.0;
        iter = gradientList_.begin();
        while( iter != gradientList_.end() ){
            resultGradientTemp += (*iter);       
            ++iter;
        }
        resultGradient_ = resultGradientTemp / gradientList_.size();
        //resultGradient_ = (double)lines[1] / (double)lines[0];
        int lefty = (-lines[2]*resultGradient_)+lines[3];
        int righty = ((result2.cols-lines[2])*resultGradient_)+lines[3];

        cv::line(result2,cv::Point(result2.cols-1,righty),cv::Point(0,lefty),cv::Scalar(255,0,0),1);

        //std::cout << "gradient_ : " << resultGradient_ << std::endl;
        
    }

    cv::line(result2,cv::Point(CENTER_COORDINATES,CENTER_COORDINATES),cv::Point(centroidX_,centroidY_),cv::Scalar(0,0,255),1);


    //resultGradient_ = (-1.0) / ((centroidY_ - CENTER_COORDINATES) / (centroidX_ - CENTER_COORDINATES));

    cv::Vec3b & colorR = imgLaser_.at<cv::Vec3b>(CENTER_COORDINATES,CENTER_COORDINATES);;
    //... do something to the color ....
    colorR[0] = 0;
    colorR[1] = 100;
    colorR[2] = 255;

    // set pixel
    result2.at<cv::Vec3b>(cv::Point(CENTER_COORDINATES,CENTER_COORDINATES)) = colorR;


    // cv::imshow("Laser Image", result2);


    distnaceRemainingToCenter_ = std::sqrt( ((double)centroidX_ - (double)CENTER_COORDINATES) * ((double)centroidX_ - (double)CENTER_COORDINATES) + ((double)centroidY_ - (double)CENTER_COORDINATES) * ((double)centroidY_ - (double)CENTER_COORDINATES) ) * 0.005;
    // std::cout << "distance to center : " << distanceRemaining << std::endl;
}

