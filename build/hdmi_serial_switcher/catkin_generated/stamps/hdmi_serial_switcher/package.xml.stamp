<?xml version="1.0"?>
<package>
  <name>hdmi_serial_switcher</name>
  <version>0.0.0</version>
  <description>Example package for using http://wjwwood.io/serial/ library</description>

  <author email="jm.lee@in-tegrit.com">jmlee</author>

